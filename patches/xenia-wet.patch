+    kContrastBoost, kEps, kSharpStartY, kSharpScaleY, kSharpStrengthMin,
+    kSharpStrengthScale, kSharpLimitMin, kSharpLimitScale;
+
+// NVScalerUpdateConfig, SDR.
+void SetUpConfig(float sharpness) {
+  sharpness = saturate(sharpness);
+  float slider = sharpness - 0.5f;
+  float max_scale = slider >= 0.0f ? 1.25f : 1.75f;
+  float min_scale = slider >= 0.0f ? 1.25f : 1.0f;
+  float limit_scale = slider >= 0.0f ? 1.25f : 1.0f;
+  kDetectRatio = 2.0f * 1127.0f / 1024.0f;
+  kDetectThres = 64.0f / 1024.0f;
+  kMinContrastRatio = 2.0f;
+  float max_contrast_ratio = 10.0f;
+  kSharpStartY = 0.45f;
+  float sharp_end_y = 0.9f;
+  kSharpStrengthMin = max(0.0f, 0.4f + slider * min_scale * 1.2f);
+  float sharp_strength_max = 1.6f + slider * max_scale * 1.8f;
+  kSharpLimitMin = max(0.1f, 0.14f + slider * limit_scale * 0.32f);
+  float sharp_limit_max = 0.5f + slider * limit_scale * 0.6f;
+  kRatioNorm = 1.0f / (max_contrast_ratio - kMinContrastRatio);
+  kSharpScaleY = 1.0f / (sharp_end_y - kSharpStartY);
+  kSharpStrengthScale = sharp_strength_max - kSharpStrengthMin;
+  kSharpLimitScale = sharp_limit_max - kSharpLimitMin;
+  kContrastBoost = 1.0f;
+  kEps = 1.0f / 255.0f;
+}
