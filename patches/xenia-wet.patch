+void D3D12CommandProcessor::WetNoteWork(int kind, const std::string& what,
+                                        uint64_t amount) {
+  WetWork& work = wet_work_[kind][what];
+  ++work.count;
+  work.amount += amount;
+}
+
+void D3D12CommandProcessor::WetLogWork() {
+  static const char* const kKinds[] = {
+      "render target copies (EDRAM tiles; a 1280x720 32bpp target is 720)",
+      "resolves (pixels)", "texture loads", "draws by render target setup"};
+  double frames = double(wet_work_frames_);
+  for (int kind = 0; kind < 4; ++kind) {
+    std::vector<std::pair<std::string, WetWork>> sorted(wet_work_[kind].begin(),
+                                                        wet_work_[kind].end());
+    uint64_t count = 0, amount = 0;
+    for (const auto& e : sorted) {
+      count += e.second.count;
+      amount += e.second.amount;
+    }
+    XELOGW("WET GPU work per frame, {}: {:.1f}, amount {:.0f}", kKinds[kind],
+           count / frames, amount / frames);
+    std::sort(sorted.begin(), sorted.end(), [](const auto& a, const auto& b) {
+      return a.second.amount != b.second.amount
+                 ? a.second.amount > b.second.amount
+                 : a.second.count > b.second.count;
+    });
+    for (size_t i = 0; i < sorted.size() && i < 10; ++i) {
+      XELOGW("    {:.2f} x {}, amount {:.0f}", sorted[i].second.count / frames,
+             sorted[i].first, sorted[i].second.amount / frames);
+    }
+    wet_work_[kind].clear();
+  }
+  static uint64_t skipped_before = 0, skipped_tiles_before = 0;
+  uint64_t skipped = wet_rt_copies_skipped.load(std::memory_order_relaxed);
+  uint64_t skipped_tiles = wet_rt_tiles_skipped.load(std::memory_order_relaxed);
+  XELOGW("WET GPU work per frame: {:.1f} render target copies skipped "
+         "(contents unchanged), {:.0f} tiles",
+         (skipped - skipped_before) / frames,
+         (skipped_tiles - skipped_tiles_before) / frames);
+  skipped_before = skipped;
+  skipped_tiles_before = skipped_tiles;
+  wet_work_frames_ = 0;
+}
+
+void D3D12CommandProcessor::WetTsMark(uint8_t label) {
+  if (!wet_ts_frame_ || !submission_open_) {
+    return;
+  }
+  uint32_t& count = wet_ts_count_[wet_ts_slot_];
+  if (count >= kWetTsPerFrame) {
+    return;
+  }
+  deferred_command_list_.D3DEndTimestamp(
+      wet_ts_heap_, wet_ts_slot_ * kWetTsPerFrame + count);
+  wet_ts_label_[wet_ts_slot_][count++] = label;
+}
+
+void D3D12CommandProcessor::WetTsReadSlot(uint32_t slot) {
+  uint32_t count = wet_ts_count_[slot];
+  if (count < 2) {
+    return;
+  }
+  D3D12_RANGE range;
+  range.Begin = SIZE_T(slot) * kWetTsPerFrame * 8;
+  range.End = range.Begin + SIZE_T(count) * 8;
+  void* mapping;
+  if (FAILED(wet_ts_readback_->Map(0, &range, &mapping))) {
+    return;
+  }
+  const uint64_t* ts = reinterpret_cast<const uint64_t*>(
+      static_cast<const uint8_t*>(mapping) + range.Begin);
+  uint64_t ticks[kWetGpuCatCount] = {};
+  uint64_t total = 0;
+  bool valid = true;
+  for (uint32_t i = 0; i + 1 < count; ++i) {
+    if (ts[i + 1] < ts[i]) {
+      valid = false;
+      break;
+    }
+    uint64_t d = ts[i + 1] - ts[i];
+    ticks[wet_ts_label_[slot][i]] += d;
+    total += d;
+  }
+  D3D12_RANGE written = {};
+  wet_ts_readback_->Unmap(0, &written);
+  // Skip a frame that took over a second (a loading stall, or bad data).
+  if (!valid || total * wet_ts_us_per_tick_ > 1000000.0) {
+    return;
+  }
+  for (uint32_t i = 0; i < kWetGpuCatCount; ++i) {
+    wet_gpu_time_us[i].fetch_add(uint64_t(ticks[i] * wet_ts_us_per_tick_),
+                                 std::memory_order_relaxed);
+  }
+  wet_gpu_frames.fetch_add(1, std::memory_order_relaxed);
+}
