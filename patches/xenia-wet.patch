+    parameter.DescriptorTable.NumDescriptorRanges = 1;
+    parameter.DescriptorTable.pDescriptorRanges = &ranges[i];
+    parameter.ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  }
+  D3D12_STATIC_SAMPLER_DESC samplers[2] = {};
+  for (uint32_t i = 0; i < 2; ++i) {
+    samplers[i].Filter = i ? D3D12_FILTER_MIN_MAG_MIP_POINT
+                           : D3D12_FILTER_MIN_MAG_LINEAR_MIP_POINT;
+    samplers[i].AddressU = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    samplers[i].AddressV = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    samplers[i].AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    samplers[i].MaxAnisotropy = 1;
+    samplers[i].ComparisonFunc = D3D12_COMPARISON_FUNC_NEVER;
+    samplers[i].BorderColor = D3D12_STATIC_BORDER_COLOR_OPAQUE_BLACK;
+    samplers[i].ShaderRegister = i;
+    samplers[i].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  }
+  D3D12_ROOT_SIGNATURE_DESC root_signature_desc;
+  root_signature_desc.NumParameters = UINT(xe::countof(parameters));
+  root_signature_desc.pParameters = parameters;
+  root_signature_desc.NumStaticSamplers = UINT(xe::countof(samplers));
+  root_signature_desc.pStaticSamplers = samplers;
+  root_signature_desc.Flags = D3D12_ROOT_SIGNATURE_FLAG_NONE;
+  *(wet_smaa_root_signature_.ReleaseAndGetAddressOf()) =
+      ui::d3d12::util::CreateRootSignature(provider, root_signature_desc);
+  if (!wet_smaa_root_signature_) {
+    XELOGW("SMAA: failed to create the root signature");
+    return false;
+  }
+
+  static const char* const kEntries[3] = {"edges_main", "weights_main",
+                                          "blend_main"};
+  for (uint32_t i = 0; i < 3; ++i) {
+    std::vector<uint8_t> code = wet_smaa::Compile(kEntries[i]);
+    if (code.empty()) {
+      return false;
+    }
+    *(wet_smaa_pipelines_[i].ReleaseAndGetAddressOf()) =
+        ui::d3d12::util::CreateComputePipeline(device, code.data(),
+                                               code.size(),
+                                               wet_smaa_root_signature_.Get());
+    if (!wet_smaa_pipelines_[i]) {
+      XELOGW("SMAA: failed to create the {} pipeline", kEntries[i]);
+      return false;
+    }
+  }
+
+  // Lookup textures, filled from an upload buffer on first use.
+  D3D12_RESOURCE_DESC desc = {};
+  desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+  desc.DepthOrArraySize = 1;
+  desc.MipLevels = 1;
+  desc.SampleDesc.Count = 1;
+  desc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+  ID3D12Resource** luts[2] = {wet_smaa_area_.ReleaseAndGetAddressOf(),
+                              wet_smaa_search_.ReleaseAndGetAddressOf()};
+  const unsigned char* lut_data[2] = {wet_smaa::areaTexBytes,
+                                      wet_smaa::searchTexBytes};
+  uint32_t lut_width[2] = {wet_smaa::kAreaTexWidth,
+                           wet_smaa::kSearchTexWidth};
+  uint32_t lut_height[2] = {wet_smaa::kAreaTexHeight,
+                            wet_smaa::kSearchTexHeight};
+  uint32_t lut_bpp[2] = {2, 1};
+  DXGI_FORMAT lut_format[2] = {DXGI_FORMAT_R8G8_UNORM, DXGI_FORMAT_R8_UNORM};
+  UINT64 upload_size = 0;
+  for (uint32_t i = 0; i < 2; ++i) {
+    desc.Width = lut_width[i];
+    desc.Height = lut_height[i];
+    desc.Format = lut_format[i];
+    desc.Flags = D3D12_RESOURCE_FLAG_NONE;
+    if (FAILED(device->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesDefault,
+            provider.GetHeapFlagCreateNotZeroed(), &desc,
+            D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+            IID_PPV_ARGS(luts[i])))) {
+      XELOGW("SMAA: failed to create a lookup texture");
+      return false;
+    }
+    UINT64 size;
+    device->GetCopyableFootprints(&desc, 0, 1, upload_size,
+                                  &wet_smaa_upload_footprints_[i], nullptr,
+                                  nullptr, &size);
+    upload_size = xe::align(wet_smaa_upload_footprints_[i].Offset + size,
+                            UINT64(D3D12_TEXTURE_DATA_PLACEMENT_ALIGNMENT));
+  }
+  D3D12_RESOURCE_DESC buffer_desc;
+  ui::d3d12::util::FillBufferResourceDesc(buffer_desc, upload_size,
+                                          D3D12_RESOURCE_FLAG_NONE);
+  if (FAILED(device->CreateCommittedResource(
+          &ui::d3d12::util::kHeapPropertiesUpload,
+          provider.GetHeapFlagCreateNotZeroed(), &buffer_desc,
+          D3D12_RESOURCE_STATE_GENERIC_READ, nullptr,
+          IID_PPV_ARGS(&wet_smaa_upload_)))) {
+    XELOGW("SMAA: failed to create the upload buffer");
+    return false;
+  }
+  uint8_t* mapping;
+  D3D12_RANGE read_range = {};
+  if (FAILED(wet_smaa_upload_->Map(0, &read_range,
+                                   reinterpret_cast<void**>(&mapping)))) {
+    return false;
+  }
+  for (uint32_t i = 0; i < 2; ++i) {
+    const D3D12_PLACED_SUBRESOURCE_FOOTPRINT& footprint =
+        wet_smaa_upload_footprints_[i];
+    for (uint32_t y = 0; y < lut_height[i]; ++y) {
+      std::memcpy(mapping + footprint.Offset + footprint.Footprint.RowPitch * y,
+                  lut_data[i] + lut_width[i] * lut_bpp[i] * y,
+                  lut_width[i] * lut_bpp[i]);
+    }
+  }
+  wet_smaa_upload_->Unmap(0, nullptr);
+  wet_smaa_luts_uploaded_ = false;
+  wet_smaa_ready_ = true;
+  XELOGW("SMAA: ready");
+  return true;
+}
+
+void D3D12CommandProcessor::WetSmaaShutdown() {
+  for (auto& pipeline : wet_smaa_pipelines_) {
+    pipeline.Reset();
+  }
+  wet_smaa_root_signature_.Reset();
+  wet_smaa_edges_.Reset();
+  wet_smaa_weights_.Reset();
+  wet_smaa_area_.Reset();
+  wet_smaa_search_.Reset();
+  wet_smaa_upload_.Reset();
+  wet_smaa_textures_submission_ = 0;
+  wet_smaa_tried_ = false;
+  wet_smaa_ready_ = false;
+  wet_smaa_luts_uploaded_ = false;
+}
+
+bool D3D12CommandProcessor::WetSmaaApply(ID3D12Resource* source,
+                                         ID3D12Resource* dest, uint32_t width,
+                                         uint32_t height) {
+  const ui::d3d12::D3D12Provider& provider = GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+
+  // Frame-sized intermediate textures (recreated when the size changes).
+  if (wet_smaa_edges_ && (wet_smaa_edges_->GetDesc().Width != width ||
+                          wet_smaa_edges_->GetDesc().Height != height)) {
+    for (ID3D12Resource* old : {wet_smaa_edges_.Get(), wet_smaa_weights_.Get()}) {
+      if (GetCompletedSubmission() < wet_smaa_textures_submission_) {
+        old->AddRef();
+        resources_for_deletion_.emplace_back(wet_smaa_textures_submission_,
+                                             old);
+      }
+    }
+    wet_smaa_edges_.Reset();
+    wet_smaa_weights_.Reset();
+  }
+  if (!wet_smaa_edges_) {
+    D3D12_RESOURCE_DESC desc = {};
+    desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    desc.Width = width;
+    desc.Height = height;
+    desc.DepthOrArraySize = 1;
+    desc.MipLevels = 1;
+    desc.SampleDesc.Count = 1;
+    desc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    desc.Format = DXGI_FORMAT_R8G8_UNORM;
+    bool ok = SUCCEEDED(device->CreateCommittedResource(
+        &ui::d3d12::util::kHeapPropertiesDefault,
+        provider.GetHeapFlagCreateNotZeroed(), &desc,
+        D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, nullptr,
+        IID_PPV_ARGS(&wet_smaa_edges_)));
+    desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    ok = ok && SUCCEEDED(device->CreateCommittedResource(
+                   &ui::d3d12::util::kHeapPropertiesDefault,
+                   provider.GetHeapFlagCreateNotZeroed(), &desc,
+                   D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, nullptr,
+                   IID_PPV_ARGS(&wet_smaa_weights_)));
+    if (!ok) {
+      XELOGW("SMAA: failed to create the {}x{} textures", width, height);
+      wet_smaa_edges_.Reset();
+      wet_smaa_weights_.Reset();
+      return false;
+    }
+  }
+  wet_smaa_textures_submission_ = GetCurrentSubmission();
+
+  if (!wet_smaa_luts_uploaded_) {
+    ID3D12Resource* luts[2] = {wet_smaa_area_.Get(), wet_smaa_search_.Get()};
+    for (uint32_t i = 0; i < 2; ++i) {
+      D3D12_TEXTURE_COPY_LOCATION dst, src;
+      dst.pResource = luts[i];
+      dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+      dst.SubresourceIndex = 0;
+      src.pResource = wet_smaa_upload_.Get();
+      src.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+      src.PlacedFootprint = wet_smaa_upload_footprints_[i];
+      deferred_command_list_.D3DCopyTextureRegion(&dst, 0, 0, 0, &src,
+                                                   nullptr);
+      PushTransitionBarrier(luts[i], D3D12_RESOURCE_STATE_COPY_DEST,
+                            D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    }
+    wet_smaa_luts_uploaded_ = true;
+  }
+
+  // 3 passes: (UAV, SRVs...).
+  ui::d3d12::util::DescriptorCpuGpuHandlePair descriptors[9];
+  if (!RequestOneUseSingleViewDescriptors(9, descriptors)) {
+    return false;
+  }
+  auto uav = [&](ID3D12Resource* resource, DXGI_FORMAT format,
+                 const ui::d3d12::util::DescriptorCpuGpuHandlePair& handle) {
+    D3D12_UNORDERED_ACCESS_VIEW_DESC uav_desc = {};
+    uav_desc.Format = format;
+    uav_desc.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+    device->CreateUnorderedAccessView(resource, nullptr, &uav_desc,
+                                      handle.first);
+  };
+  auto srv = [&](ID3D12Resource* resource, DXGI_FORMAT format,
+                 const ui::d3d12::util::DescriptorCpuGpuHandlePair& handle) {
+    D3D12_SHADER_RESOURCE_VIEW_DESC srv_desc = {};
+    srv_desc.Format = format;
+    srv_desc.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    srv_desc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    srv_desc.Texture2D.MipLevels = 1;
+    device->CreateShaderResourceView(resource, &srv_desc, handle.first);
+  };
+  uav(wet_smaa_edges_.Get(), DXGI_FORMAT_R8G8_UNORM, descriptors[0]);
+  srv(source, kFxaaSourceTextureFormat, descriptors[1]);
+  uav(wet_smaa_weights_.Get(), DXGI_FORMAT_R8G8B8A8_UNORM, descriptors[2]);
+  srv(wet_smaa_edges_.Get(), DXGI_FORMAT_R8G8_UNORM, descriptors[3]);
+  srv(wet_smaa_area_.Get(), DXGI_FORMAT_R8G8_UNORM, descriptors[4]);
+  srv(wet_smaa_search_.Get(), DXGI_FORMAT_R8_UNORM, descriptors[5]);
+  uav(dest, ui::d3d12::D3D12Presenter::kGuestOutputFormat, descriptors[6]);
+  srv(source, kFxaaSourceTextureFormat, descriptors[7]);
+  srv(wet_smaa_weights_.Get(), DXGI_FORMAT_R8G8B8A8_UNORM, descriptors[8]);
+
+  float metrics[4] = {1.0f / float(width), 1.0f / float(height), float(width),
+                      float(height)};
+  deferred_command_list_.D3DSetComputeRootSignature(
+      wet_smaa_root_signature_.Get());
+  deferred_command_list_.D3DSetComputeRoot32BitConstants(0, 4, metrics, 0);
+  uint32_t groups_x = (width + 7) / 8, groups_y = (height + 7) / 8;
+  auto pass = [&](uint32_t index, ID3D12Resource* target,
+                  uint32_t first_descriptor, uint32_t source_count) {
+    if (target != dest) {
+      PushTransitionBarrier(target,
+                            D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+                            D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    }
+    deferred_command_list_.D3DSetComputeRootDescriptorTable(
+        1, descriptors[first_descriptor].second);
+    for (uint32_t i = 0; i < 3; ++i) {
+      // Unused tables still need something bound: repeat the first source.
+      uint32_t d = first_descriptor + 1 + std::min(i, source_count - 1);
+      deferred_command_list_.D3DSetComputeRootDescriptorTable(
+          2 + i, descriptors[d].second);
+    }
+    SetExternalPipeline(wet_smaa_pipelines_[index].Get());
+    SubmitBarriers();
+    deferred_command_list_.D3DDispatch(groups_x, groups_y, 1);
+    if (target != dest) {
+      PushTransitionBarrier(target, D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+                            D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    }
+  };
+  pass(0, wet_smaa_edges_.Get(), 0, 1);
+  pass(1, wet_smaa_weights_.Get(), 2, 3);
+  pass(2, dest, 6, 2);
+  return true;
+}
+#endif  // XE_WET_RUNTIME
+
 }  // namespace d3d12
 }  // namespace gpu
 }  // namespace xe
