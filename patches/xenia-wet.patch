+
+inline std::vector<uint8_t> Compile() {
+  std::vector<uint8_t> result;
+  HMODULE module = LoadLibraryW(L"D3DCompiler_47.dll");
+  if (!module) {
+    XELOGW("NIS: D3DCompiler_47.dll not found; NVIDIA Image Scaling unavailable");
+    return result;
+  }
+  auto compile = reinterpret_cast<pD3DCompile>(
+      reinterpret_cast<void*>(GetProcAddress(module, "D3DCompile")));
+  if (!compile) {
+    return result;
+  }
+  const char* source = Source();
+  ID3DBlob* code = nullptr;
+  ID3DBlob* errors = nullptr;
+  HRESULT hr = compile(source, std::strlen(source), "wet_nis.hlsl", nullptr,
+                       nullptr, "main", "ps_5_1",
+                       D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &code, &errors);
+  if (errors) {
+    XELOGW("NIS shader compiler output: {}",
+           static_cast<const char*>(errors->GetBufferPointer()));
+    errors->Release();
+  }
+  if (SUCCEEDED(hr) && code) {
+    const uint8_t* data =
+        static_cast<const uint8_t*>(code->GetBufferPointer());
+    result.assign(data, data + code->GetBufferSize());
+    XELOGW("NIS: NVIDIA Image Scaling shader ready ({} bytes)", result.size());
+  } else {
+    XELOGW("NIS: shader compilation failed (0x{:08X})", uint32_t(hr));
+  }
+  if (code) {
+    code->Release();
+  }
+  return result;
+}
