+float FilterNormal(float p[6][6], int phase_x, int phase_y) {
+  float h_acc = 0.0f;
+  [unroll] for (int j = 0; j < 6; ++j) {
+    float v_acc = 0.0f;
+    [unroll] for (int i = 0; i < 6; ++i) {
+      v_acc += p[i][j] * kCoefScaler[phase_y][i];
+    }
+    h_acc += v_acc * kCoefScaler[phase_x][j];
+  }
+  return h_acc;
+}
