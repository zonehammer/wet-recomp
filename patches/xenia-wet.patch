+    temp_interp45Deg[2] = lerp(p[2][2], b, abs(pphase_b45));
+    temp_interp45Deg[4] = lerp(p[3][3], c, abs(pphase_b45));
+    temp_interp45Deg[6] = lerp(p[4][4], d, abs(pphase_b45));
