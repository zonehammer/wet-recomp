+// Compiles one of the passes ("edges_main", "weights_main", "blend_main").
+inline std::vector<uint8_t> Compile(const char* entry) {
+  std::vector<uint8_t> result;
+  static HMODULE module = LoadLibraryW(L"D3DCompiler_47.dll");
+  if (!module) {
+    XELOGW("SMAA: D3DCompiler_47.dll not found");
+    return result;
+  }
+  auto compile = reinterpret_cast<pD3DCompile>(
+      reinterpret_cast<void*>(GetProcAddress(module, "D3DCompile")));
+  if (!compile) {
+    return result;
+  }
+  const std::string& source = Source();
+  ID3DBlob* code = nullptr;
+  ID3DBlob* errors = nullptr;
+  HRESULT hr = compile(source.data(), source.size(), "wet_smaa.hlsl", nullptr,
+                       nullptr, entry, "cs_5_1",
+                       D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &code, &errors);
+  if (errors) {
+    XELOGW("SMAA shader compiler output ({}): {}", entry,
+           static_cast<const char*>(errors->GetBufferPointer()));
+    errors->Release();
+  }
+  if (SUCCEEDED(hr) && code) {
+    const uint8_t* data =
+        static_cast<const uint8_t*>(code->GetBufferPointer());
+    result.assign(data, data + code->GetBufferSize());
+  } else {
+    XELOGW("SMAA: {} failed to compile (0x{:08X})", entry, uint32_t(hr));
+  }
+  if (code) {
+    code->Release();
+  }
+  return result;
+}
