+    int shift45 = pphase_p45 >= 1 ? 1 : 0;
+    [unroll] for (int i = 0; i < 6; i++) {
+      interp45Deg[i] = shift45 ? temp_interp45Deg[i + 1] : temp_interp45Deg[i];
+    }
+    if (shift45) {
+      pphase_p45 = pphase_p45 - 1;
+    }
+    f += EvalPoly6(interp45Deg, int(pphase_p45 * 64)) * w.z;
+  }
+  if (w.w > 0.0f) {
+    float pphase_b135 = 0.5f * (phase_x_frac + phase_y_frac);
+    float temp_interp135Deg[7];
+    temp_interp135Deg[1] = lerp(p[3][1], p[4][2], pphase_b135);
+    temp_interp135Deg[3] = lerp(p[2][2], p[3][3], pphase_b135);
+    temp_interp135Deg[5] = lerp(p[1][3], p[2][4], pphase_b135);
+    pphase_b135 = pphase_b135 - 0.5f;
+    float a = (pphase_b135 >= 0.f) ? p[5][2] : p[3][0];
+    float b = (pphase_b135 >= 0.f) ? p[4][3] : p[2][1];
+    float c = (pphase_b135 >= 0.f) ? p[3][4] : p[1][2];
+    float d = (pphase_b135 >= 0.f) ? p[2][5] : p[0][3];
+    temp_interp135Deg[0] = lerp(p[4][1], a, abs(pphase_b135));
+    temp_interp135Deg[2] = lerp(p[3][2], b, abs(pphase_b135));
+    temp_interp135Deg[4] = lerp(p[2][3], c, abs(pphase_b135));
+    temp_interp135Deg[6] = lerp(p[1][4], d, abs(pphase_b135));
+    float interp135Deg[6];
+    float pphase_p135 = 1 + (phase_x_frac - phase_y_frac);
+    int shift135 = pphase_p135 >= 1 ? 1 : 0;
+    [unroll] for (int i = 0; i < 6; ++i) {
+      interp135Deg[i] = shift135 ? temp_interp135Deg[i + 1] : temp_interp135Deg[i];
+    }
+    if (shift135) {
+      pphase_p135 = pphase_p135 - 1;
+    }
+    f += EvalPoly6(interp135Deg, int(pphase_p135 * 64)) * w.w;
+  }
+  return f;
+}
+
+float3 LoadClamped(int2 pos, int2 size) {
+  return xe_nis_source.Load(int3(clamp(pos, int2(0, 0), size - 1), 0)).rgb;
+}
+
+float4 main(float4 xe_position : SV_Position) : SV_Target {
+  SetUpConfig(xe_nis_sharpness);
+  uint width, height;
+  xe_nis_source.GetDimensions(width, height);
+  int2 size = int2(width, height);
+
+  int2 dst = int2(xe_position.xy) - xe_nis_output_offset;
+  float2 src = (float2(dst) + 0.5f) * xe_nis_scale - 0.5f;
+  float2 src_floor = floor(src);
+  int2 src_int = int2(src_floor);
+  float fx = src.x - src_floor.x;
+  float fy = src.y - src_floor.y;
+  int fx_int = int(fx * kPhaseCount);
+  int fy_int = int(fy * kPhaseCount);
+
+  // 6x6 luma support around the source position (rows y, columns x).
+  float p[6][6];
+  [unroll] for (int i = 0; i < 6; ++i) {
+    [unroll] for (int j = 0; j < 6; ++j) {
+      p[i][j] = GetY(LoadClamped(src_int + int2(j - 2, i - 2), size));
+    }
+  }
+
+  // Edge map of the 2x2 pixels around the position, from 3x3 windows.
+  float4 e00 = GetEdgeMap(p, 1, 1);
+  float4 e01 = GetEdgeMap(p, 1, 2);
+  float4 e10 = GetEdgeMap(p, 2, 1);
+  float4 e11 = GetEdgeMap(p, 2, 2);
+  float4 w = lerp(lerp(e00, e01, fx), lerp(e10, e11, fx), fy);
+
+  float base_weight = 1.0f - w.x - w.y - w.z - w.w;
+  float op_y = FilterNormal(p, fx_int, fy_int) * base_weight;
+  op_y += AddDirFilters(p, fx, fy, fx_int, fy_int, w);
+
+  // Bilinear color at the source position, corrected to the filtered luma.
+  float3 c00 = LoadClamped(src_int, size);
+  float3 c01 = LoadClamped(src_int + int2(1, 0), size);
+  float3 c10 = LoadClamped(src_int + int2(0, 1), size);
+  float3 c11 = LoadClamped(src_int + int2(1, 1), size);
+  float3 op = lerp(lerp(c00, c01, fx), lerp(c10, c11, fx), fy);
+  op += op_y - GetY(op);
+  return float4(saturate(op), 1.0f);
+}
